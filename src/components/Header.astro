---
const pathname = Astro.url.pathname;
const isHome = pathname === '/' || pathname === '';
---

<header class="border-b border-rule/80">
  <div class="mx-auto flex max-w-3xl items-end justify-between gap-6 px-5 pb-6 pt-10 md:px-8 md:pt-14">
    <div class="min-w-0">
      <p class="mb-2 font-mono text-[0.68rem] uppercase tracking-[0.22em] text-ink-muted">
        Morning Brief
      </p>
      {
        isHome ? (
          <h1 class="font-display text-[1.65rem] font-medium leading-tight tracking-tight text-ink md:text-[2rem]">
            Xiaowu 晨间简报
          </h1>
        ) : (
          <a
            href="/"
            class="font-display text-[1.65rem] font-medium leading-tight tracking-tight text-ink transition-colors hover:text-accent md:text-[2rem]"
          >
            Xiaowu 晨间简报
          </a>
        )
      }
      <p class="mt-2 max-w-md text-[0.92rem] leading-relaxed text-ink-muted">
        科技与 AI 的清晨短读
      </p>
    </div>
    <nav aria-label="主导航" class="shrink-0 pb-1">
      <a
        href="/"
        class:list={[
          'font-mono text-[0.72rem] uppercase tracking-[0.16em] transition-colors',
          isHome ? 'text-ink' : 'text-ink-muted hover:text-ink',
        ]}
      >
        归档
      </a>
    </nav>
  </div>
</header>
