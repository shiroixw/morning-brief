---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BriefCard from '../components/BriefCard.astro';

const briefs = (await getCollection('briefs')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const [latest, ...rest] = briefs;
---

<BaseLayout>
  <Header />
  <main id="main" class="mx-auto w-full max-w-3xl flex-1 px-5 py-12 md:px-8 md:py-16">
    {
      briefs.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-rule bg-card/60 px-6 py-16 text-center">
          <p class="font-display text-xl text-ink">尚无简报</p>
          <p class="mt-3 text-ink-muted">晨间例程写入后，这里会出现每日短读。</p>
        </div>
      ) : (
        <>
          <section aria-labelledby="latest-heading" class="mb-14">
            <div class="mb-6 flex items-baseline justify-between gap-4">
              <h2
                id="latest-heading"
                class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-ink-muted"
              >
                最新一期
              </h2>
              <span class="h-px flex-1 bg-rule/80" aria-hidden="true" />
            </div>
            <BriefCard
              href={`/briefs/${latest.id}`}
              title={latest.data.title}
              date={latest.data.date}
              summary={latest.data.summary}
              sample={latest.data.sample}
              featured
            />
          </section>

          {
            rest.length > 0 && (
              <section aria-labelledby="archive-heading">
                <div class="mb-6 flex items-baseline justify-between gap-4">
                  <h2
                    id="archive-heading"
                    class="font-mono text-[0.72rem] uppercase tracking-[0.18em] text-ink-muted"
                  >
                    往期归档
                  </h2>
                  <span class="h-px flex-1 bg-rule/80" aria-hidden="true" />
                </div>
                <div class="grid gap-5">
                  {rest.map((brief) => (
                    <BriefCard
                      href={`/briefs/${brief.id}`}
                      title={brief.data.title}
                      date={brief.data.date}
                      summary={brief.data.summary}
                      sample={brief.data.sample}
                    />
                  ))}
                </div>
              </section>
            )
          }
        </>
      )
    }
  </main>
  <Footer />
</BaseLayout>
